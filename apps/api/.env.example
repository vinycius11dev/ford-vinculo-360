DATABASE_URL="mysql://ford:ford_local@127.0.0.1:3306/ford_vinculo_360"
SHADOW_DATABASE_URL="mysql://ford:ford_local@127.0.0.1:3306/ford_vinculo_360_shadow"
NODE_ENV=development
PORT=3000
# Só habilite a UI Swagger em desenvolvimento; ela é desativada em produção.
ENABLE_API_DOCS=true
# Tokens de desenvolvimento aparecem apenas com console SMTP e API local.
EXPOSE_DEVELOPMENT_TOKENS=false
# Número exato de proxies confiáveis à frente da API; mantenha 0 se não houver proxy.
TRUST_PROXY_HOPS=0
# Painel web (Vite) e app mobile rodando no navegador (Expo web).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081"
JWT_SECRET="substitua-por-um-segredo-longo-antes-de-produzir"
# Obrigatório em produção; URL base pública HTTPS usada ao gerar links de uploads.
PUBLIC_API_ORIGIN=""
ML_SERVICE_URL="http://localhost:8000"
APP_WEB_URL="http://localhost:5173"
# Link da experiência do proprietário. Em produção, use a URL pública do app
# ou o deep link nativo, por exemplo: fordvinculo360://activate
APP_CUSTOMER_APP_URL="http://localhost:8081"
# Canal externo homologado no piloto: e-mail via SMTP. Deixe vazio para simulação local.
MAIL_FROM="Ford Vínculo 360 <no-reply@ford360.local>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
